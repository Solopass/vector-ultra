            }

            /* Hardware Zero-Copy: No static filter or transition on video to preserve D3D11 MPO Overlay */
            video.html5-main-video {
                transform: scale(var(--vz, 1)) translate(var(--vx, 0px), var(--vy, 0px)) !important;
