                font-family: monospace;
                display: none;
                pointer-events: none;
            }

            #vector-panel {
                position: fixed;
                top: 130px;
                right: 20px;
                z-index: 2147483646;
                background: #111;
                color: #fff;
                padding: 15px;
                border: 1px solid #444;
                border-radius: 10px;
                display: none;
                width: 330px;
                font-family: sans-serif;
                max-height: 85vh;
                overflow-y: auto;
                box-shadow: 0 10px 40px #000;
            }

            .drag-handle {
                cursor: grab;
                background: #222;
                margin: -15px -15px 15px -15px;
                padding: 12px;
                text-align: center;
