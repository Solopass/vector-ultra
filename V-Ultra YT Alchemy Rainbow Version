(function () {
    'use strict';

    // =========================================================================
    // PHASE 1: FRAME-ZERO MODERN STORAGE PRE-SEED & CONFIG HOOK (@run-at document-start)
    // =========================================================================

    const preSeedStoredQuality = () => {
        try {
            const now = Date.now();
            const te = now + (365 * 24 * 60 * 60 * 1000); // 1 year
            // Modern YouTube DASH player expects nested JSON object with pixel height
            const payload = {
                data: JSON.stringify({ quality: 4320, previousQuality: 4320 }),
                expiration: te,
                creation: now
            };
            localStorage.setItem('yt-player-quality', JSON.stringify(payload));
            localStorage.setItem('yt-player-bandwidth', JSON.stringify({
                data: 104857600, // 100 Mbps
                expiration: te,
                creation: now
            }));
        } catch (_) {}
    };

    preSeedStoredQuality();

    // Hook Storage.prototype.getItem to guarantee YouTube always receives max credentials
    try {
        const origGetItem = Storage.prototype.getItem;
        Storage.prototype.getItem = function (key) {
            if (key === 'yt-player-quality') {
                return JSON.stringify({
                    data: JSON.stringify({ quality: 4320, previousQuality: 4320 }),
                    expiration: Date.now() + (365 * 24 * 60 * 60 * 1000),
                    creation: Date.now()
                });
            }
            if (key === 'yt-player-bandwidth') {
                return JSON.stringify({
                    data: 104857600,
                    expiration: Date.now() + (365 * 24 * 60 * 60 * 1000),
                    creation: Date.now()
                });
            }
            return origGetItem.apply(this, arguments);
        };
    } catch (_) {}

    // Hook ytcfg / ytplayer config to lock native player to highres
    const hookYtConfig = () => {
        const pWindow = (typeof unsafeWindow !== 'undefined' && unsafeWindow) ? unsafeWindow : window;
        if (pWindow.ytcfg && pWindow.ytcfg.set) {
            try {
                const currentFlags = (pWindow.ytcfg.get && pWindow.ytcfg.get('EXPERIMENT_FLAGS')) || {};
                pWindow.ytcfg.set({
                    'EXPERIMENT_FLAGS': {
                        ...currentFlags,
                        html5_default_quality: 'highres',
                        html5_min_quality: 'highres'
                    }
                });
            } catch (_) {}
        }
    };
    hookYtConfig();

    // =========================================================================
    // PHASE 2: UI, THEATRE MODE, SMART FIT & ZERO-COPY MPO ACCELERATION
    // =========================================================================

    function initVUltraUI() {
        if (window.__VECTOR_ULTRA_UI_LOADED__) return;
        window.__VECTOR_ULTRA_UI_LOADED__ = true;

        let video = null;
        let lastVideoSrc = null;
        let settings = { zoom: 1, x: 0, y: 0, bright: 100, cont: 100, sat: 100, sharpen: 0, shortsZoom: 1.25 };
        let lockSettings = GM_getValue('vector_lockState', false);
        let smartFitActive = GM_getValue('vector_smartFitState', true);
        let zoomTimer = null;
        let fitDebounceTimer = null;
        let uiIdleTimer = null;
        let scriptInitTime = Date.now();
        let isPlayingState = false;
        let qualityAttemptedForVideo = '';

        let db = GM_getValue('vectorSmartVideoDB', {
            presets: { "Default Reset": { zoom: 1, x: 0, y: 0, bright: 100, cont: 100, sat: 100, sharpen: 0, shortsZoom: 1.25 } },
            channels: {}
        });
        const saveDB = () => GM_setValue('vectorSmartVideoDB', db);

        GM_addStyle(`
            :root {
                --vz: 1;
                --vx: 0px;
                --vy: 0px;
                --ytd-masthead-height: 0px !important;
                --ytd-toolbar-height: 0px !important;
