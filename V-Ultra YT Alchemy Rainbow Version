                animation: vultra-rainbow 3s linear infinite !important;
            }

            #vector-panel.vultra-max-quality .drag-handle {
                border-bottom: 2px solid #ff0055 !important;
                animation: vultra-rainbow 3s linear infinite !important;
            }

            /* VECTOR UI - Stealth Logic */
            .vector-ui-element {
                transition: opacity 0.4s ease-in-out !important;
            }
            .vector-ui-hidden {
                opacity: 0 !important;
                pointer-events: none !important;
            }

            #vector-btn {
                position: fixed;
                top: 80px;
                right: 20px;
                z-index: 2147483647;
                padding: 10px 14px;
                background: #111;
                color: #fff;
                border: 1px solid #444;
                border-radius: 8px;
                cursor: pointer;
